%{
#include <stdio.h>
int line = 1;
%}

%option noyywrap

%%

[ \t]+                         ;

\n                             { line++; }

"int"                          { printf("Line %d: KEYWORD -> %s\n", line, yytext); }
"float"                        { printf("Line %d: KEYWORD -> %s\n", line, yytext); }
"char"                         { printf("Line %d: KEYWORD -> %s\n", line, yytext); }
"if"                           { printf("Line %d: KEYWORD -> %s\n", line, yytext); }
"else"                         { printf("Line %d: KEYWORD -> %s\n", line, yytext); }
"while"                        { printf("Line %d: KEYWORD -> %s\n", line, yytext); }
"for"                          { printf("Line %d: KEYWORD -> %s\n", line, yytext); }
"return"                       { printf("Line %d: KEYWORD -> %s\n", line, yytext); }

[a-zA-Z_][a-zA-Z0-9_]*         { printf("Line %d: IDENTIFIER -> %s\n", line, yytext); }

[0-9]+                         { printf("Line %d: NUMBER -> %s\n", line, yytext); }

"=="|"!="|"<="|">="            { printf("Line %d: OPERATOR -> %s\n", line, yytext); }

"+"|"-"|"*"|"/"|"="|"<"|">"    { printf("Line %d: OPERATOR -> %s\n", line, yytext); }

"("|")"|"{"|"}"|";"|","        { printf("Line %d: SYMBOL -> %s\n", line, yytext); }

\"[^\"]*\"                     { printf("Line %d: STRING -> %s\n", line, yytext); }

"//".*                         ;

.                              { printf("Line %d: ERROR -> %s\n", line, yytext); }

%%

int main()
{
    printf("Enter the program:\n");
    yylex();
    return 0;
}
